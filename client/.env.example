# URL da API. Em dev deixe vazio (o Vite faz proxy de /api para localhost:4000).
# Em produção (Vercel): https://nika-tenis-api.onrender.com
VITE_API_URL=

# WhatsApp de reserva (só dígitos, com 55 + DDD), usado se a API ainda não tiver o número.
# [COMPLETAR] ex.: 5554999999999
VITE_WHATSAPP_NUMBER=

# Versão de teste: "true" pede ao Google para não indexar o site. Remova no lançamento oficial.
VITE_NOINDEX=
